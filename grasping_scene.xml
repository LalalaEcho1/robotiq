<mujoco model="robotiq_2f85_grasping">
  <!-- 基于 Robotiq 2F-85 的抓取场景 - 带有可移动夹爪 -->
  <compiler angle="radian" meshdir="assets" autolimits="true"/>
  
  <option timestep="0.002" integrator="implicitfast" iterations="500" solver="Newton" tolerance="1e-10" cone="elliptic" impratio="1"/>

  <statistic center="0 0 0.15" extent="0.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="60" elevation="-20"/>
  </visual>

  <asset>
    <!-- 夹爪材质 -->
    <material name="metal" rgba="0.58 0.58 0.58 1"/>
    <material name="silicone" rgba="0.1882 0.1882 0.1882 1"/>
    <material name="gray" rgba="0.4627 0.4627 0.4627 1"/>
    <material name="black" rgba="0.149 0.149 0.149 1"/>
    
    <!-- 夹爪mesh -->
    <mesh class="2f85" file="base_mount.stl"/>
    <mesh class="2f85" file="base.stl"/>
    <mesh class="2f85" file="driver.stl"/>
    <mesh class="2f85" file="coupler.stl"/>
    <mesh class="2f85" file="follower.stl"/>
    <mesh class="2f85" file="pad.stl"/>
    <mesh class="2f85" file="silicone_pad.stl"/>
    <mesh class="2f85" file="spring_link.stl"/>

    <!-- 场景材质 -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="target_mat" rgba="0.8 0.2 0.2 1"/>

    <!-- 目标物体 mesh (动态加载时会替换路径) -->
    <mesh name="target_mesh" file="object_meshes/000/mesh.obj" scale="1 1 1"/>
  </asset>

  <default>
    <joint damping="1.0" armature="0.1" frictionloss="0"/>
    <geom friction="1.0 0.005 0.0001" solref="0.02 1" solimp="0.9 0.95 0.001"/>

    <default class="2f85">
      <mesh scale="0.001 0.001 0.001"/>
      <general biastype="affine"/>

      <joint axis="1 0 0"/>
      <default class="driver">
        <joint range="0 0.8" armature="0.1" damping="1.0" solimplimit="0.95 0.99 0.001" solreflimit="0.05 1"/>
      </default>
      <default class="follower">
        <joint range="-0.872664 0.872664" armature="0.05" pos="0 -0.018 0.0065" damping="0.5" solimplimit="0.95 0.99 0.001" solreflimit="0.05 1"/>
      </default>
      <default class="spring_link">
        <joint range="-0.29670597283 0.8" armature="0.05" stiffness="0.05" springref="2.62" damping="0.5"/>
      </default>
      <default class="coupler">
        <joint range="-1.57 0" armature="0.05" damping="0.5" solimplimit="0.95 0.99 0.001" solreflimit="0.05 1"/>
      </default>

      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3" contype="1" conaffinity="1"/>
        <default class="pad_box1">
          <geom mass="0" type="box" pos="0 -0.0026 0.028125" size="0.011 0.004 0.009375" friction="1.5 0.05 0.01"
            solimp="0.95 0.99 0.001" solref="0.004 1" priority="1" rgba="0.55 0.55 0.55 1" contype="1" conaffinity="1"/>
        </default>
        <default class="pad_box2">
          <geom mass="0" type="box" pos="0 -0.0026 0.009375" size="0.011 0.004 0.009375" friction="1.5 0.05 0.01"
            solimp="0.95 0.99 0.001" solref="0.004 1" priority="1" rgba="0.45 0.45 0.45 1" contype="1" conaffinity="1"/>
        </default>
      </default>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 1.5"/>
    <light pos="0 -0.3 1" dir="0 0.2 -0.8" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Mocap目标位置 (不可见的控制点) -->
    <body name="hand_mocap" pos="0 0 0.5" quat="0 1 0 0" mocap="true">
      <geom type="sphere" size="0.01" rgba="1 0 0 0.3" contype="0" conaffinity="0"/>
    </body>

    <!-- 可移动的夹爪基座 (用freejoint实现物理移动，通过weld约束跟随mocap) -->
    <!-- 初始位置: z=0.5 在物体上方 -->
    <!-- quat="0 1 0 0" 表示绕X轴旋转180度，使夹爪朝下 -->
    <body name="gripper_base" pos="0 0 0.5" quat="0 1 0 0">
      <freejoint name="gripper_joint"/>
      <inertial pos="0 0 0" mass="2.0" diaginertia="0.01 0.01 0.01"/>

      <!-- Robotiq 2F-85 夹爪结构 (从2f85.xml复制) -->
      <body name="base_mount" pos="0 0 0.007" childclass="2f85">
        <geom class="visual" mesh="base_mount" material="black"/>
        <geom class="collision" mesh="base_mount"/>
        <body name="base" pos="0 0 0.0038" quat="1 0 0 -1">
          <inertial mass="0.777441" pos="0 -2.70394e-05 0.0354675" quat="1 -0.00152849 0 0"
            diaginertia="0.000260285 0.000225381 0.000152708"/>
          <geom class="visual" mesh="base" material="black"/>
          <geom class="collision" mesh="base"/>
          <site name="pinch" pos="0 0 0.145" type="sphere" group="5" rgba="0.9 0.9 0.9 1" size="0.005"/>

          <!-- Right-hand side 4-bar linkage -->
          <body name="right_driver" pos="0 0.0306011 0.054904">
            <inertial mass="0.00899563" pos="2.96931e-12 0.0177547 0.00107314" quat="0.681301 0.732003 0 0"
              diaginertia="1.72352e-06 1.60906e-06 3.22006e-07"/>
            <joint name="right_driver_joint" class="driver"/>
            <geom class="visual" mesh="driver" material="gray"/>
            <geom class="collision" mesh="driver"/>
            <body name="right_coupler" pos="0 0.0315 -0.0041">
              <inertial mass="0.0140974" pos="0 0.00301209 0.0232175" quat="0.705636 -0.0455904 0.0455904 0.705636"
                diaginertia="4.16206e-06 3.52216e-06 8.88131e-07"/>
              <joint name="right_coupler_joint" class="coupler"/>
              <geom class="visual" mesh="coupler" material="black"/>
              <geom class="collision" mesh="coupler"/>
            </body>
          </body>
          <body name="right_spring_link" pos="0 0.0132 0.0609">
            <inertial mass="0.0221642" pos="-8.65005e-09 0.0181624 0.0212658" quat="0.663403 -0.244737 0.244737 0.663403"
              diaginertia="8.96853e-06 6.71733e-06 2.63931e-06"/>
            <joint name="right_spring_link_joint" class="spring_link"/>
            <geom class="visual" mesh="spring_link" material="black"/>
            <geom class="collision" mesh="spring_link"/>
            <body name="right_follower" pos="0 0.055 0.0375">
              <inertial mass="0.0125222" pos="0 -0.011046 0.0124786" quat="1 0.1664 0 0"
                diaginertia="2.67415e-06 2.4559e-06 6.02031e-07"/>
              <joint name="right_follower_joint" class="follower"/>
              <geom class="visual" mesh="follower" material="black"/>
              <geom class="collision" mesh="follower"/>
              <body name="right_pad" pos="0 -0.0189 0.01352">
                <geom class="pad_box1" name="right_pad1"/>
                <geom class="pad_box2" name="right_pad2"/>
                <inertial mass="0.0035" pos="0 -0.0025 0.0185" quat="0.707107 0 0 0.707107"
                  diaginertia="4.73958e-07 3.64583e-07 1.23958e-07"/>
                <geom class="visual" mesh="pad"/>
                <body name="right_silicone_pad">
                  <geom class="visual" mesh="silicone_pad" material="black"/>
                </body>
              </body>
            </body>
          </body>

          <!-- Left-hand side 4-bar linkage -->
          <body name="left_driver" pos="0 -0.0306011 0.054904" quat="0 0 0 1">
            <inertial mass="0.00899563" pos="0 0.0177547 0.00107314" quat="0.681301 0.732003 0 0"
              diaginertia="1.72352e-06 1.60906e-06 3.22006e-07"/>
            <joint name="left_driver_joint" class="driver"/>
            <geom class="visual" mesh="driver" material="gray"/>
            <geom class="collision" mesh="driver"/>
            <body name="left_coupler" pos="0 0.0315 -0.0041">
              <inertial mass="0.0140974" pos="0 0.00301209 0.0232175" quat="0.705636 -0.0455904 0.0455904 0.705636"
                diaginertia="4.16206e-06 3.52216e-06 8.88131e-07"/>
              <joint name="left_coupler_joint" class="coupler"/>
              <geom class="visual" mesh="coupler" material="black"/>
              <geom class="collision" mesh="coupler"/>
            </body>
          </body>
          <body name="left_spring_link" pos="0 -0.0132 0.0609" quat="0 0 0 1">
            <inertial mass="0.0221642" pos="-8.65005e-09 0.0181624 0.0212658" quat="0.663403 -0.244737 0.244737 0.663403"
              diaginertia="8.96853e-06 6.71733e-06 2.63931e-06"/>
            <joint name="left_spring_link_joint" class="spring_link"/>
            <geom class="visual" mesh="spring_link" material="black"/>
            <geom class="collision" mesh="spring_link"/>
            <body name="left_follower" pos="0 0.055 0.0375">
              <inertial mass="0.0125222" pos="0 -0.011046 0.0124786" quat="1 0.1664 0 0"
                diaginertia="2.67415e-06 2.4559e-06 6.02031e-07"/>
              <joint name="left_follower_joint" class="follower"/>
              <geom class="visual" mesh="follower" material="black"/>
              <geom class="collision" mesh="follower"/>
              <body name="left_pad" pos="0 -0.0189 0.01352">
                <geom class="pad_box1" name="left_pad1"/>
                <geom class="pad_box2" name="left_pad2"/>
                <inertial mass="0.0035" pos="0 -0.0025 0.0185" quat="1 0 0 1"
                  diaginertia="4.73958e-07 3.64583e-07 1.23958e-07"/>
                <geom class="visual" mesh="pad"/>
                <body name="left_silicone_pad">
                  <geom class="visual" mesh="silicone_pad" material="black"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- 桌子 (带碰撞) -->
    <body name="table" pos="0 0 0.15">
      <geom name="table_top" type="box" size="0.3 0.3 0.15" rgba="0.4 0.3 0.2 1"
            friction="0.8 0.02 0.01" contype="1" conaffinity="1"/>
    </body>

    <!-- 目标物体 (使用 mesh，放在桌子上) -->
    <!-- 桌面高度 0.3m，物体中心根据 mesh 大小调整 -->
    <body name="target_object" pos="0 0 0.35">
      <freejoint name="target_joint"/>
      <geom name="target_geom" type="mesh" mesh="target_mesh" mass="0.05"
            material="target_mat" friction="0.7 0.02 0.01" contype="1" conaffinity="1"/>
    </body>
  </worldbody>

  <contact>
    <exclude body1="base" body2="left_driver"/>
    <exclude body1="base" body2="right_driver"/>
    <exclude body1="base" body2="left_spring_link"/>
    <exclude body1="base" body2="right_spring_link"/>
    <exclude body1="right_coupler" body2="right_follower"/>
    <exclude body1="left_coupler" body2="left_follower"/>
    <!-- 补充: 消除 spring_link 与 base_mount/gripper_base 的潜在碰撞 -->
    <exclude body1="gripper_base" body2="right_spring_link"/>
    <exclude body1="gripper_base" body2="left_spring_link"/>
    <exclude body1="base_mount" body2="right_spring_link"/>
    <exclude body1="base_mount" body2="left_spring_link"/>
    <!-- 补充: 消除 driver 与 follower 的潜在碰撞 -->
    <exclude body1="right_driver" body2="right_follower"/>
    <exclude body1="left_driver" body2="left_follower"/>
    <!-- 补充: 消除 pad 与 spring_link 的潜在碰撞 -->
    <exclude body1="right_pad" body2="right_spring_link"/>
    <exclude body1="left_pad" body2="left_spring_link"/>
    <!-- 补充: 消除 follower 与 pad 的碰撞 -->
    <exclude body1="right_follower" body2="right_pad"/>
    <exclude body1="left_follower" body2="left_pad"/>
  </contact>

  <tendon>
    <fixed name="split" damping="0.5">
      <joint joint="right_driver_joint" coef="0.5"/>
      <joint joint="left_driver_joint" coef="0.5"/>
    </fixed>
  </tendon>

  <equality>
    <!-- Weld约束: 让gripper_base跟随hand_mocap -->
    <weld body1="hand_mocap" body2="gripper_base" solref="0.2 1" solimp="0.9 0.95 0.001"/>
    
    <connect anchor="0 0 0" body1="right_follower" body2="right_coupler" solimp="0.95 0.99 0.001" solref="0.05 1"/>
    <connect anchor="0 0 0" body1="left_follower" body2="left_coupler" solimp="0.95 0.99 0.001" solref="0.05 1"/>
    <joint joint1="right_driver_joint" joint2="left_driver_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001"
      solref="0.05 1"/>
  </equality>

  <actuator>
    <general class="2f85" name="fingers_actuator" tendon="split" forcerange="-20 20" ctrlrange="0 255"
      gainprm="0.3137255 0 0" biasprm="0 -100 -10"/>
  </actuator>
</mujoco>